APP_NAME="EKN - Media"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.test
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de-DE

APP_MAINTENANCE_DRIVER=file
APP_SAFE_MODE=true
ALLOW_DESTRUCTIVE_DB_COMMANDS=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=redaktion@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_ADDRESS=

VITE_APP_NAME="${APP_NAME}"

# Microsoft / Azure AD Login
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Fallback: E-Mail/Passwort-Login
# LOCAL_LOGIN_ENABLED=true
# LOCAL_LOGIN_ALLOWED_EMAILS=

# Medien-Tools
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_PATH=/usr/bin/ffmpeg
YT_DLP_PATH=/usr/bin/yt-dlp
YT_DLP_EXTRA_ARGS=

# Publication Evidence (YouTube-Screenshots)
PUBLICATION_EVIDENCE_AUTO_BUILD=false
PUBLICATION_EVIDENCE_PLAYWRIGHT_SCRIPT=scripts/youtube-evidence-screenshots.mjs

# OpenAI (Bild-Metadaten + Web-Text in Admin)
OPENAI_API_KEY=
OPENAI_MODEL_VISION=gpt-4.1-mini
OPENAI_ORG=
MEDIA_AI_RATE_LIMIT_PER_MINUTE=10

AI_WORKER_PATH=

# Lexware
LEXWARE_BASE_URL=https://api.lexware.io
LEXWARE_API_KEY=
LEXWARE_TIMEOUT=20

# Dropbox (Backup)
DROPBOX_AUTH_TOKEN=
BACKUP_COMPRESSION_METHOD=bzip2
# BACKUP_MAX_STORAGE_MB=20000

DELIVERY_DOWNLOAD_NOTIFY_EMAIL=

# Object Storage (S3-kompatibel, z. B. Hetzner)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Video-Ingest
INGEST_INBOX_PATH=upload
INGEST_ENABLED=true
INGEST_PREVIEW_AUTO=true
INGEST_FFMPEG_THREADS=1
INGEST_FFMPEG_FILTER_THREADS=1
INGEST_OUTPUT_X264_THREADS=1
INGEST_OUTPUT_MAX_WIDTH=1920
INGEST_OUTPUT_MAX_HEIGHT=1080
INGEST_OUTPUT_VIDEO_BITRATE=12.4M
INGEST_OUTPUT_FPS=50
INGEST_OUTPUT_FORCE_INTERLACED=false
INGEST_OUTPUT_VBV_BUFSIZE=12.4M
INGEST_LOW_MEMORY_PROFILE=false
INGEST_NORMALIZE_AUDIO_CHANNELS=2
INGEST_OUTPUT_X264_PRESET=veryfast
INGEST_OUTPUT_X264_RC_LOOKAHEAD=0
INGEST_OUTPUT_MAX_GIGABYTES=0.9
INGEST_ARCHIVE_RAW_AFTER_SUCCESS=false
INGEST_AUTO_CLEAR_AFTER_RENDER=true

PRESSEPORTAL_API_KEY=

# Zeugen-Upload (optional eigene Subdomain)
WITNESS_PORTAL_HOST=
WITNESS_PORTAL_SCHEME=https
# WITNESS_DISK=local
# WITNESS_MAX_FILE_KB=153600
# WITNESS_MAX_FILES_PER_SUBMIT=20
# WITNESS_MIN_SECONDS=4
# WITNESS_LEGAL_VERSION=2026-04-01-v1

# Event-Discovery (Ticketmaster)
EVENT_DISCOVERY_ENABLED=false
EVENT_DISCOVERY_TICKETMASTER_KEY=
EVENT_DISCOVERY_TM_LATLONG=50.94,6.92
EVENT_DISCOVERY_TM_RADIUS_KM=100
EVENT_DISCOVERY_TM_CITY_ALLOWLIST=Köln,Cologne,Düsseldorf,Aachen,Bonn,Nürburg

# Multi-Brand
# BRANDS_DOMAIN_ROUTING_ENABLED=false
# BRAND_ERFTKREIS_HOST=erftkreis-news.media
# BRAND_KOELNIMAGE_HOST=koelnimage.de
# DEFAULT_BRAND_KEY=erftkreis_news

# Nominatim (OpenStreetMap Geocoding, optional)
# NOMINATIM_CONTACT_EMAIL=
# NOMINATIM_USER_AGENT="EKN-Media/1.0"
# NOMINATIM_COUNTRYCODES=de
# NOMINATIM_CACHE_TTL=3600
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
