<?php

use App\Http\Controllers\Admin\AudioController;
use App\Http\Controllers\Admin\BackofficeController;
use App\Http\Controllers\Admin\CustomerProductController;
use App\Http\Controllers\Admin\DashboardController;
use App\Http\Controllers\Admin\DeliveryController as AdminDeliveryController;
use App\Http\Controllers\Admin\DeliveryDestinationController;
use App\Http\Controllers\Admin\NewsDeliveryController;
use App\Http\Controllers\Admin\SettingsController;
use App\Http\Controllers\Admin\UserController;
use App\Http\Controllers\Admin\VideoController;
use App\Http\Controllers\Auth\MicrosoftAuthController;
use App\Http\Controllers\Customer\DashboardController as CustomerDashboardController;
use App\Http\Controllers\DeliveryController;
use App\Http\Controllers\NewsController;
use App\Http\Controllers\ProfileController;
use App\Http\Controllers\SitemapController;
use Illuminate\Support\Facades\Route;

// Hilfs-Closure: Modul fehlt (Controller-Datei nicht vorhanden) – Redirect mit Hinweis
$moduleUnavailable = function () {
    return redirect()->route('admin.dashboard')
        ->with('error', 'Dieses Modul ist derzeit nicht verfügbar. Bitte Controller-Dateien aus Backup oder Git wiederherstellen.');
};

// ========== Öffentlich ==========
Route::get('/', [NewsController::class, 'index'])->name('home');
Route::get('/news/{slug}', [NewsController::class, 'show'])->name('news.show');
Route::get('/robots.txt', [SitemapController::class, 'robots'])->name('robots');
Route::get('/sitemap.xml', [SitemapController::class, 'index'])->name('sitemap.index');
Route::get('/sitemap-news.xml', [SitemapController::class, 'newsSitemap'])->name('sitemap.news');

// ========== Delivery (signed, ohne Login) ==========
Route::get('/d/{token}', [DeliveryController::class, 'show'])->name('delivery.show')->middleware('throttle:60,1');
Route::post('/d/{token}/confirm', [DeliveryController::class, 'confirm'])->name('delivery.confirm')->middleware('throttle:30,1');
Route::get('/d/{token}/m/{media}', [DeliveryController::class, 'download'])->name('delivery.download')->middleware('throttle:30,1');

// ========== Auth (Login, Microsoft, Passwort) ==========
Route::get('/auth/microsoft/redirect', [MicrosoftAuthController::class, 'redirect'])->name('auth.microsoft.redirect');
Route::get('/auth/microsoft/callback', [MicrosoftAuthController::class, 'callback'])->name('auth.microsoft.callback');
require __DIR__ . '/auth.php';

// ========== Nach Login (auth) ==========
Route::middleware(['auth'])->group(function () {
    Route::get('/dashboard', function () {
        if (auth()->user()->can('access_admin')) {
            return redirect()->route('admin.dashboard');
        }
        return view('dashboard');
    })->name('dashboard');

    Route::get('/profile', [ProfileController::class, 'edit'])->name('profile.edit');
    Route::patch('/profile', [ProfileController::class, 'update'])->name('profile.update');
    Route::delete('/profile', [ProfileController::class, 'destroy'])->name('profile.destroy');
});

// ========== Admin (/admin, auth + access_admin) ==========
Route::middleware(['auth', 'permission:access_admin'])->prefix('admin')->name('admin.')->group(function () use ($moduleUnavailable) {
    Route::get('/', [DashboardController::class, 'index'])->name('dashboard');

    // News (Modul: NewsItemController – bei fehlender Datei Redirect)
    Route::get('/news', $moduleUnavailable)->name('news.index');
    Route::get('/news/create', $moduleUnavailable)->name('news.create');
    Route::post('/news', $moduleUnavailable)->name('news.store');
    Route::get('/news/{newsItem}/edit', $moduleUnavailable)->name('news.edit');
    Route::patch('/news/{newsItem}', $moduleUnavailable)->name('news.update');
    Route::delete('/news/{newsItem}', $moduleUnavailable)->name('news.destroy');
    Route::get('/news/{newsItem}/media/{mediaId}/edit', $moduleUnavailable)->name('news.media.edit');
    Route::patch('/news/{newsItem}/media/{mediaId}', $moduleUnavailable)->name('news.media.update');
    Route::delete('/news/{newsItem}/media/{mediaId}', $moduleUnavailable)->name('news.media.destroy');
    Route::post('/news/{newsItem}/media/{mediaId}/unlink', $moduleUnavailable)->name('news.media.unlink');
    Route::get('/news/{newsItem}/media/{mediaId}/unkentlich', $moduleUnavailable)->name('news.media.unkentlich');
    Route::post('/news/{newsItem}/media/{mediaId}/unkentlich', $moduleUnavailable)->name('news.media.unkentlich.apply');
    Route::post('/news/{newsItem}/media/{mediaId}/unkentlich-aufheben', $moduleUnavailable)->name('news.media.unkentlich.aufheben');
    Route::patch('/news/{newsItem}/media/{mediaId}/redaction', $moduleUnavailable)->name('news.media.redaction.update');
    Route::post('/news/{newsItem}/media/{mediaId}/redaction/run', $moduleUnavailable)->name('news.media.redaction.run');
    Route::post('/news/{newsItem}/media/{mediaId}/redaction/run-now', $moduleUnavailable)->name('news.media.redaction.run-now');
    Route::get('/news/{newsItem}/media/{mediaId}/ai-status', $moduleUnavailable)->name('news.media.ai-status');
    Route::post('/news/{newsItem}/media/{mediaId}/request-ai', $moduleUnavailable)->name('news.media.request-ai');
    Route::post('/news/{newsItem}/apply-author-credit', $moduleUnavailable)->name('news.apply-author-credit');
    Route::get('/news/{newsItem}/send', [NewsDeliveryController::class, 'prepareSend'])->name('news.send');
    Route::post('/news/{newsItem}/send', [NewsDeliveryController::class, 'send'])->name('news.send.post');
    Route::get('/news/{newsItem}/send-summary', [NewsDeliveryController::class, 'summary'])->name('news.send-summary');
    Route::post('/news/{newsItem}/send-summary', [NewsDeliveryController::class, 'applySummary'])->name('news.send-summary.apply');

    // Deliveries
    Route::get('/deliveries', [AdminDeliveryController::class, 'index'])->name('deliveries.index');
    Route::get('/deliveries/{delivery}/activity', [AdminDeliveryController::class, 'show'])->name('deliveries.show');
    Route::post('/deliveries/{delivery}/revoke', [AdminDeliveryController::class, 'revoke'])->name('deliveries.revoke');

    Route::get('/video', [VideoController::class, 'index'])->name('video.index');
    Route::get('/audio', [AudioController::class, 'index'])->name('audio.index');

    // Settings
    Route::get('/settings', [SettingsController::class, 'index'])->name('settings.index');
    Route::get('/settings/seo', [SettingsController::class, 'seo'])->name('settings.seo');
    Route::get('/settings/seo/google-connect', [SettingsController::class, 'googleConnect'])->name('settings.seo.google-connect');
    Route::get('/settings/seo/google-callback', [SettingsController::class, 'googleCallback'])->name('settings.seo.google-callback');
    Route::post('/settings/seo/google-disconnect', [SettingsController::class, 'googleDisconnect'])->name('settings.seo.google-disconnect');
    Route::get('/settings/backup', $moduleUnavailable)->name('settings.backup');
    Route::post('/settings/backup/run', $moduleUnavailable)->name('settings.backup.run');
    Route::get('/settings/ai', $moduleUnavailable)->name('settings.ai');
    Route::post('/settings/ai/test', $moduleUnavailable)->name('settings.ai.test');
    Route::get('/settings/jobs', $moduleUnavailable)->name('settings.jobs');
    Route::post('/settings/jobs/run', $moduleUnavailable)->name('settings.jobs.run');
    Route::get('/settings/media', $moduleUnavailable)->name('settings.media');

    // Backoffice
    Route::get('/backoffice', [BackofficeController::class, 'index'])->name('backoffice.index');

    Route::get('/backoffice/users', [UserController::class, 'index'])->name('backoffice.users.index');
    Route::get('/backoffice/users/{user}/edit', [UserController::class, 'edit'])->name('backoffice.users.edit');
    Route::post('/backoffice/users/{user}', [UserController::class, 'update'])->name('backoffice.users.update');
    Route::delete('/backoffice/users/{user}', [UserController::class, 'destroy'])->name('backoffice.users.destroy');

    // Billing (Modul fehlt)
    Route::get('/backoffice/billing', $moduleUnavailable)->name('backoffice.billing.index');
    Route::get('/backoffice/billing/create/{product}', $moduleUnavailable)->name('backoffice.billing.create');
    Route::post('/backoffice/billing', $moduleUnavailable)->name('backoffice.billing.store');
    Route::get('/backoffice/billing/{invoice}', $moduleUnavailable)->name('backoffice.billing.show');
    Route::get('/backoffice/billing/{invoice}/pdf', $moduleUnavailable)->name('backoffice.billing.pdf');
    Route::get('/backoffice/billing/{invoice}/zugferd', $moduleUnavailable)->name('backoffice.billing.zugferd');
    Route::get('/backoffice/billing/{invoice}/lexware-file', $moduleUnavailable)->name('backoffice.billing.lexware-file');
    Route::post('/backoffice/billing/{invoice}/send', $moduleUnavailable)->name('backoffice.billing.send');
    Route::post('/backoffice/billing/{invoice}/ready-for-lexware', $moduleUnavailable)->name('backoffice.billing.ready-for-lexware');
    Route::post('/backoffice/billing/{invoice}/release', $moduleUnavailable)->name('backoffice.billing.release');

    // Usage (Modul fehlt)
    Route::get('/backoffice/usage', $moduleUnavailable)->name('backoffice.usage.index');
    Route::get('/backoffice/usage/create', $moduleUnavailable)->name('backoffice.usage.create');
    Route::post('/backoffice/usage', $moduleUnavailable)->name('backoffice.usage.store');
    Route::get('/backoffice/usage/{record}/edit', $moduleUnavailable)->name('backoffice.usage.edit');
    Route::post('/backoffice/usage/{record}', $moduleUnavailable)->name('backoffice.usage.update');
    Route::delete('/backoffice/usage/{record}', $moduleUnavailable)->name('backoffice.usage.destroy');

    // Customers (Modul CustomerController fehlt)
    Route::get('/customers', $moduleUnavailable)->name('customers.index');
    Route::get('/customers/create', $moduleUnavailable)->name('customers.create');
    Route::post('/customers', $moduleUnavailable)->name('customers.store');
    Route::get('/customers/{organization}', $moduleUnavailable)->name('customers.show');
    Route::get('/customers/{organization}/edit', $moduleUnavailable)->name('customers.edit');
    Route::post('/customers/{organization}', $moduleUnavailable)->name('customers.update');
    Route::delete('/customers/{organization}', $moduleUnavailable)->name('customers.destroy');

    Route::get('/customers/{organization}/products', [CustomerProductController::class, 'index'])->name('customers.products.index');
    Route::get('/customers/{organization}/products/create', [CustomerProductController::class, 'create'])->name('customers.products.create');
    Route::post('/customers/{organization}/products', [CustomerProductController::class, 'store'])->name('customers.products.store');
    Route::get('/customers/{organization}/products/{product}/edit', [CustomerProductController::class, 'edit'])->name('customers.products.edit');
    Route::post('/customers/{organization}/products/{product}', [CustomerProductController::class, 'update'])->name('customers.products.update');
    Route::post('/customers/{organization}/products/{product}/import-lexware', [CustomerProductController::class, 'importLexware'])->name('customers.products.import-lexware');
    Route::delete('/customers/{organization}/products/{product}', [CustomerProductController::class, 'destroy'])->name('customers.products.destroy');

    Route::get('/products/{product}/destinations', [DeliveryDestinationController::class, 'index'])->name('destinations.index');
    Route::get('/products/{product}/destinations/create', [DeliveryDestinationController::class, 'create'])->name('destinations.create');
    Route::post('/products/{product}/destinations', [DeliveryDestinationController::class, 'store'])->name('destinations.store');
    Route::get('/destinations/{destination}/edit', [DeliveryDestinationController::class, 'edit'])->name('destinations.edit');
    Route::post('/destinations/{destination}', [DeliveryDestinationController::class, 'update'])->name('destinations.update');
    Route::delete('/destinations/{destination}', [DeliveryDestinationController::class, 'destroy'])->name('destinations.destroy');

    // Contacts (Modul CustomerContactController fehlt)
    Route::get('/customers/{organization}/contacts', $moduleUnavailable)->name('customers.contacts.index');
    Route::get('/customers/{organization}/contacts/create', $moduleUnavailable)->name('customers.contacts.create');
    Route::post('/customers/{organization}/contacts', $moduleUnavailable)->name('customers.contacts.store');
    Route::get('/contacts/{contact}/edit', $moduleUnavailable)->name('customers.contacts.edit');
    Route::post('/contacts/{contact}', $moduleUnavailable)->name('customers.contacts.update');
    Route::delete('/contacts/{contact}', $moduleUnavailable)->name('customers.contacts.destroy');
});

// ========== Kundenbereich (/kunden, view_customer_area) ==========
Route::middleware(['auth', 'permission:view_customer_area'])->group(function () {
    Route::get('/kunden', [CustomerDashboardController::class, 'index'])->name('customer.dashboard');
});
